# ==========================================================
# Copie para .env e preencha. O .env NUNCA vai para o Git.
#   cp .env.example .env
# ==========================================================

# ---------- OpenAI ----------
# Crie em: https://platform.openai.com/api-keys  (ver docs/01-openai-setup.md)
OPENAI_API_KEY=sk-proj-COLE_SUA_CHAVE_AQUI
OPENAI_MODEL=gpt-5
OPENAI_MODEL_FAST=gpt-5-mini
# Teto de gasto mensal em USD (checado pelo app antes de cada chamada)
OPENAI_MONTHLY_BUDGET_USD=50

# ---------- Navegador (sua sessão real do Instagram) ----------
# Ver docs/02-browser-session.md
CHROME_CDP_URL=http://127.0.0.1:9222
CHROME_PROFILE_DIR=./.chrome-profile

# ---------- Instagram API oficial (Meta) ----------
# Usada SOMENTE depois que o lead responder
INSTAGRAM_APP_SECRET=
INSTAGRAM_PAGE_ACCESS_TOKEN=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ---------- Banco ----------
DATABASE_URL=file:./data/crm.db

# ---------- Limites de autonomia ----------
MAX_DMS_PER_DAY=30
MIN_SECONDS_BETWEEN_DMS=90
MAX_SECONDS_BETWEEN_DMS=240
OPERATING_HOURS=09:00-20:00
OPERATING_TIMEZONE=America/Sao_Paulo
